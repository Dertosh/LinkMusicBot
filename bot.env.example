TELEGRAM_BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_LIMIT=100
MUSIC_CACHE_REFRESH_SECONDS=43200
INLINE_RESULT_LIMIT=10
INLINE_DEBOUNCE_MS=600
MUSIC_DURATION_TOLERANCE_MS=3000
